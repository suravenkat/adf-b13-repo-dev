{
	"name": "pl_source_target_compareFiles_B15",
	"properties": {
		"activities": [
			{
				"name": "GetSourceFiles",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"retryIntervalInSeconds": 30
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_getmeta1_SourceFiles",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "GetTargetFiles",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"retryIntervalInSeconds": 30
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_getmeta2_TargetFiles",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "InitNewFiles",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "NewFiles",
					"value": []
				}
			},
			{
				"name": "ForEachSourceFiles",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "GetSourceFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "GetTargetFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "InitNewFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GetSourceFiles').output.childItems",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "CheckFileNotInTarget",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@not(contains(string(activity('GetTargetFiles').output.childItems), item().name))",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "AppendNewFiles",
										"type": "AppendVariable",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"variableName": "NewFiles",
											"value": {
												"value": "@item().name",
												"type": "Expression"
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "ForEachNewFiles",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "ForEachSourceFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('NewFiles')",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "CopySingleFile",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_source_copy_compare_files",
									"type": "DatasetReference",
									"parameters": {
										"FileName": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_target_copy_target_compare_files",
									"type": "DatasetReference"
								}
							]
						}
					]
				}
			},
			{
				"name": "LogNoNewFiles",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "ForEachSourceFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "LogMessage",
					"value": {
						"value": "@concat('Num new files found. Total=', string(length(variables('NewFiles'))))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set variable1",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "LogNoNewFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "FinalListFiles",
					"value": {
						"value": "@variables('NewFiles')",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"NewFiles": {
				"type": "Array"
			},
			"LogMessage": {
				"type": "String"
			},
			"FinalListFiles": {
				"type": "Array"
			}
		},
		"annotations": []
	}
}